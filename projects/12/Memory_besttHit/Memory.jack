class Memory {
    static Array freeAdr;
    static Array freeList;

    /** Initializes the class. */
    function void init() {
        let freeAdr = 2048;
        let freeList = null;
        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        var Array memory;
        let memory = 0;
        return memory[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        var Array memory;
        let memory = 0;
        let memory[address] = value;
        return;
    }

    function Array findMatchFree(int size) {
        var Array prevAdr, curAdr, bestAdr;
        var int curSize, bestSize, size2;
        let bestAdr = null;
        let bestSize = size + size;
        let prevAdr = null;
        let curAdr = freeList;
        while (~(curAdr = null)) {
            let curSize = curAdr[-1];
            if (~(curSize < size) & curSize < bestSize) {
                let bestAdr = curAdr;
                let bestSize = curSize;
            }
            let prevAdr = curAdr;
            let curAdr = curAdr[0];
        }

        if (~(bestAdr = null)) {
            if (prevAdr = null) {
                let freeList = curAdr[0];
            }
            else {
                let prevAdr[0] = curAdr[0];
            }
        }

        return bestAdr;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function Array alloc(int size) {
        var int retAdr, curSize;
        // if size is minus,
        if (size < 0) {
            // invalid size.
            do Sys.error(1001);
        }

        let retAdr = Memory.findMatchFree(size);
        if (~(retAdr = null)) {
            return retAdr;
        }

        // if over RAM end,
        if ((16383 - freeAdr) < size) {
            // no memory.
            do Sys.error(1002);
        }
        let retAdr = freeAdr + 1;
        let retAdr[-1] = size;
        let freeAdr = freeAdr + size + 1;
        return retAdr;
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        let o[0] = freeList;
        let freeList = o;
        return;
    }
}
