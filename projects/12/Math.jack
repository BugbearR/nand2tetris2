class Math {
    static int numOfIntegerBits;    // Number of bits used for representing a two's complement integer
    static Array powersOfTwo; // Stores 2^0, 2^1, 2^2,..., 2^(n-1)

    // Initializes the Math library.
    function void init() {
        var i, mask;

        let numOfIntegerBits = 16;

        let powersOfTwo = Array.new(numOfIntegerBits);
        let mask = 1;
        let i = 0;
        while (i < numOfIntegerBits) {
            let powersOfTwo[i] = mask;
            let mask = mask + mask;
            let i = i + 1;
        }
    }

    /** Returns the product of x and y. 
     *  When a Jack compiler detects the multiplication operator '*'
     *  in an expression, it handles it by invoking this method. 
     *  Thus, in Jack, x * y and Math.multiply(x,y) return the same value. */
    function int multiply(int x, int y) {
        var int sum, mask, xf, yf, f;
        let sum = 0;
        let mask = 32767 + 1; // 0x8000

        let xf = x & mask;
        let yf = y & mask;
        if (xf) {
            let x = -x;
        }
        if (yf) {
            let y = -y;
        }
        let f = (xf | yf) & (~xf | ~yf);

        let mask = 1;
        while ((mask < y) & (mask > 0)) {
            if (y & mask) {
                // if ((32767 - sum) < x) {
                //    // overflow!
                // }

                let sum = sum + x;
            }
            let x = x + x;
            let mask = mask + mask;
        }

        if (f) {
            let sum = -sum;
        }

        return sum;
    }

    /** Returns the integer part of x / y.
     *  When a Jack compiler detects the division operator '/'
     *  an an expression, it handles it by invoking this method.
     *  Thus, x/y and Math.divide(x,y) return the same value. */
    function int divide(int x, int y) {
        var int r, mask, xf, yf, f, i;
        var Array a;

        if (y = 0) {
            // divide by zero
            // QQQ report to user.
            Sys.halt(); // return 32767; (?)
        }

        let mask = 32767 + 1; // 0x8000
        let xf = x & mask;
        let yf = y & mask;
        if (xf) {
            let x = -x;
        }
        if (yf) {
            let y = -y;
        }
        let f = (xf | yf) & (~xf | ~yf);

        let i = 0;
        let a = Array.new(16);
        while ((y > 0) & (y < x)) {
            let a[i] = y; // a[i] = y * 2^i
            let y = y + y;
            let i = i + 1;
        }

        let r = 0;
        while (i > 0) {
            let i = i - 1;
            let r = r + r;
            if (!(x < a[i])) { // x >= a[i]
                let x = x - a[i];
                let r = r + 1;
            }
        }

        if (f) {
            let r = -r;
        }

        a.dispose();
        return r;
    }

    /** Returns the integer part of the square root of x. */
    function int sqrt(int x) {
        var sq, i;
        if (x < 0) { // imaginary number
            // QQQ report to user.
            Sys.halt();
        }

        if (x < 2) {
            return x;
        }

        let i = getHighestBit(x);
        while (i > -1) {
            let t = r + powersOfTwo[i];
            let sq = t * t;
            if (!(x < sq)) {
                let r = t;
            }
            let i = i - 1;
        }
        return r;
    }

    /** Returns the greater value. */
    function int max(int a, int b) {
        if (b > a) {
            return b;
        }
        return a;
    }

    /** Returns the smaller value. */
    function int min(int a, int b) {
        if (b < a) {
            return b;
        }
        return a;
    }

    /** Returns the absolute value of x. */
    function int abs(int x) {
        if (x < 0) {
            return -x;
        }
        return x;
    }

    function int getPowerOfTwo(int n) {
        // XXX no check.
        // if ((n < 0) | !(n < numOfIntegerBits)) { // overrun
        //     // QQQ report to user.
        //     Sys.halt();
        // }
        return powersOfTwo[n];
    }

    function int getHighestBit(int x) {
        var int r, mask;
        if (x < 0) {
            return numOfIntegerBits - 1;
        }
        if (x == 0) {
            return -1;
        }

        let r = 0;
        let mask = 1;
        while (mask < x) {
            let mask = mask + mask + 1;
            let r = r + 1;
        }
        return r;
    }

    function sgn(x) {
        if (x < 0) {
            return -1;
        }
        if (x > 0) {
            return 1;
        }
        return 0;
    }
}
